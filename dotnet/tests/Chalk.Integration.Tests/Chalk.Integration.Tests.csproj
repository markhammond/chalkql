<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Chalk.Integration.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The typed read back's allocation gate (D301) measures as the executor's gates do. -->
    <Compile Include="../Shared/AllocationProbe.cs" Link="AllocationProbe.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Catalogs and statements a test plans as a host registered them, read from beside the tests. -->
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Chalk.Client/Chalk.Client.csproj" />
    <ProjectReference Include="../../src/Chalk.Incremental/Chalk.Incremental.csproj" />
    <ProjectReference Include="../../src/Chalk.Entitlements.Tenancy/Chalk.Entitlements.Tenancy.csproj" />
    <ProjectReference Include="../Chalk.TestKit/Chalk.TestKit.csproj" />
    <ProjectReference Include="../../src/Chalk.Sources.Conformance/Chalk.Sources.Conformance.csproj" />
    <ProjectReference Include="../../src/Chalk.Sources.DuckDb/Chalk.Sources.DuckDb.csproj" />
  </ItemGroup>

  <!--
    The third oracle (D28). Test-only, and only here: it ships a native library, so it must not reach
    any shipped package. The tests skip themselves when that library cannot load.
  -->
  <ItemGroup>
    <PackageReference Include="DuckDB.NET.Data.Full" />

    <!--
      The PostgreSQL driver, an ordinary reference since D133: the conformance kit's third dialect
      runs on every push against a server `PostgresFixture` starts from binaries on the machine, so
      the package is no longer opt-in and there is nothing left for reflection to find. Restoring it
      costs nothing on a machine that has no PostgreSQL.
    -->
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <!-- CHALK003 is the experimental id standing views carry: these tests are their checks. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CHALK001;CHALK003</NoWarn>
  </PropertyGroup>

</Project>