@page "/trade/{TradeId:long}"
@implements IDisposable
@inject BlotterHost Host

<PageTitle>Trade @TradeId</PageTitle>

<main>
    <div class="bar">
        <h1>Trade @TradeId.ToString("N0", CultureInfo.InvariantCulture)</h1>
        <span class="chip"><span class="label">versions</span><b>@_versions.Length</b></span>
        <span class="chip" title="Versions the database has written, and those only the live tail has yet">
            <span class="label">in the tail only</span><b>@_tailOnly.Count</b>
        </span>
    </div>

    @if (_error is not null)
    {
        <div class="refusal">@_error</div>
    }

    <p>
        One statement over both sides: <code>main.trade_versions</code> in DuckDB, and <code>live.tail_versions</code>, the
        versions the feed has sent that the snapshot does not have yet. A version in both is one row.
    </p>

    <p><a href="/">Back to the blotter</a></p>

    <div class="wide">
    <table class="history">
        <thead>
            <tr>
                @foreach (var column in Column.All)
                {
                    <th>@column.Title</th>
                }
                <th>Where</th>
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < _versions.Length; i++)
            {
                var version = _versions[i];
                var older = i + 1 < _versions.Length ? _versions[i + 1] : null;
                <tr>
                    @foreach (var column in Column.All)
                    {
                        <td class="@(older is not null && column.Show(older) != column.Show(version) ? "changed" : null)">@column.Show(version)</td>
                    }
                    <td>@(_tailOnly.Contains(version.Version) ? "tail only" : "database")</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</main>

@code {
    [Parameter]
    public long TradeId { get; set; }

    private TradeVersion[] _versions = [];
    private HashSet<int> _tailOnly = [];
    private string? _error;
    private int _busy;

    protected override async Task OnParametersSetAsync()
    {
        Host.Published -= OnPublished;
        Host.Published += OnPublished;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _versions = await Host.Queries.HistoryAsync(TradeId, CancellationToken.None);
            _tailOnly = await Host.Queries.TailOnlyAsync(TradeId, CancellationToken.None);
            _error = null;
        }
        catch (Exception failure)
        {
            _error = failure.Message;
        }
    }

    // A trade's history is one cheap statement: read again after a refresh, at most once a second.
    private void OnPublished(long version)
    {
        if (Interlocked.Exchange(ref _busy, 1) == 1)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            try
            {
                await LoadAsync();
                StateHasChanged();
                await Task.Delay(1000);
            }
            finally
            {
                Volatile.Write(ref _busy, 0);
            }
        });
    }

    public void Dispose() => Host.Published -= OnPublished;
}
