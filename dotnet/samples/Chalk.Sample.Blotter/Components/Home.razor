@page "/"
@implements IDisposable
@inject BlotterHost Host
@inject NavigationManager Nav
@inject LinkShroud Shroud

<PageTitle>Virtual blotter</PageTitle>

<main>
    <div class="bar">
        <h1>Virtual blotter</h1>
        <StatusBar Status="_status" Budget="Host.Budget" BudgetChanged="SetBudgetAsync" />
    </div>

    @if (_linkRefused is not null)
    {
        <div class="refusal">
            This link could not be opened, so the blotter opens as it always does: @_linkRefused
            <button @onclick="() => _linkRefused = null">Dismiss</button>
        </div>
    }

    <BlotterGrid @key="_tab" Tab="_tab" Link="_link" Select="t => { _tab = t; _link = null; }">
        <Toggles>
            <button type="button" class="link-button disclosure" aria-expanded="@_vitals" @onclick="ToggleVitals"><Chevron Open="_vitals" /> Vital statistics</button>
        </Toggles>
        <Actions>
                <button @onclick="Burst" title="The house takes and fills 3,000 orders at once">Simulate burst</button>
                <button @onclick="Stall" title="The database writes nothing for 20 s, while the streams go on">Stall database 20 s</button>
                @if (Host.Options.Current == CurrentSync.Lagging)
                {
                    <button @onclick="StallCurrent" title="The job that keeps orders_current applies nothing for 20 s, while order_versions is written">Stall orders_current 20 s</button>
                }
        </Actions>
        <Below>
            @* Closed, the statistics are not on the page at all, so nothing in them is rendered as they change. *@
            @if (_vitals)
            {
                <div class="bar telemetry">
                    <StatusBar Status="_status" Telemetry="true" />
                </div>
            }
        </Below>
    </BlotterGrid>
</main>

@code {
    private Tab _tab = Tab.Orders;

    // The view the page's link describes, for the tab it names, until another tab is chosen; or why
    // the link was not understood, in which case none of it is taken.
    private ViewLink? _link;
    private string? _linkRefused;
    private BlotterStatus _status = new();
    private Timer? _timer;
    private bool _vitals;

    protected override void OnInitialized()
    {
        var query = new Uri(Nav.Uri).Query;
        if (query.Length > 1)
        {
            try
            {
                _link = ViewLink.Parse(query, Shroud);
                _tab = _link.Tab;
            }
            catch (ArgumentException refused)
            {
                _linkRefused = refused.Message;
            }
        }

        _status = Host.Status;
        _timer = new Timer(_ => InvokeAsync(() => { _status = Host.Status; StateHasChanged(); }), null, 1000, 1000);
    }

    private async Task SetBudgetAsync(long bytes)
    {
        await Host.SetBudgetAsync(bytes);
        _status = Host.Status;
    }

    /// <summary>Opens or closes the vital statistics; the host reads the database's size only while some page has them open.</summary>
    private void ToggleVitals()
    {
        _vitals = !_vitals;
        Host.WatchVitals(_vitals);
    }

    private void Burst() => Host.Exchange.Send(3000);

    private void Stall() => Host.Exchange.StallIngestion(TimeSpan.FromSeconds(20));

    private void StallCurrent() => Host.Exchange.StallCurrent(TimeSpan.FromSeconds(20));

    public void Dispose()
    {
        _timer?.Dispose();
        if (_vitals)
        {
            Host.WatchVitals(false);
        }
    }
}
