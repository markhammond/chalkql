@* The browser's alerts: each a tab's filter, saved, with a sound and a throttle, firing as a row comes
   to pass it or as one that passes it waits too long for the database. A new one takes this tab's
   filters as they are; each can be tried, muted or removed. *@

<div class="alerts-panel" role="dialog" aria-label="Alerts">
    <div class="alerts-head">
        <b>Alerts</b>
        <label title="A system notification for each alert while this page is in the background, if the browser allows it">
            <input type="checkbox" checked="@Book.Notify" onchange="blotterAlerts.setNotify(this.checked)" />
            Notify in the background
        </label>
        @if (!Book.SoundOn)
        {
            <button type="button" class="link-button" onclick="blotterAlerts.enableSound()">Enable sound</button>
        }
    </div>

    @if (Book.Rules.IsEmpty)
    {
        <p class="muted">No alerts yet.</p>
    }
    else
    {
        <table class="alerts-list">
            @foreach (var rule in Book.Rules)
            {
                var r = rule;
                <tr>
                    <td><b>@r.Name</b><div class="muted">@r.Tab.Title: @Describe(r.Filter)</div></td>
                    <td class="alerts-settings">
                        <select value="@When(r.LagOver)" aria-label="When it fires" @onchange="e => SaveAsync(r with { LagOver = Lag((string)e.Value!) })">
                            @WhenOptions
                        </select>
                        <select value="@r.Sound" aria-label="Sound" @onchange="e => SaveAsync(r with { Sound = (string)e.Value! })">
                            @foreach (var (id, label) in AlertSounds.All)
                            {
                                <option value="@id">@label</option>
                            }
                        </select>
                        <select value="@r.Throttle.TotalSeconds" aria-label="At most once every" @onchange="e => SaveAsync(r with { Throttle = TimeSpan.FromSeconds(double.Parse((string)e.Value!, CultureInfo.InvariantCulture)) })">
                            @foreach (var throttle in AlertRule.Throttles)
                            {
                                <option value="@throttle.TotalSeconds">at most every @Seconds(throttle)</option>
                            }
                        </select>
                    </td>
                    <td class="alerts-actions">
                        <button type="button" class="icon-button" title="Hear it" aria-label="Hear @r.Name" onclick="blotterAlerts.play('@r.Sound')">▶</button>
                        <button type="button" class="link-button" @onclick="() => SaveAsync(r with { Muted = !r.Muted })">@(r.Muted ? "Unmute" : "Mute")</button>
                        <button type="button" class="link-button" @onclick="() => RemoveAsync(r)">Remove</button>
                    </td>
                </tr>
            }
        </table>
    }

    @* An alert's condition is the tab's filters: an example of setting them, before the row that adds it. *@
    <p class="alerts-how muted">
        An alert fires on the rows that pass this tab's filters, as they arrive, or once the database is too far behind
        them (see the Recon column). Set the filters with the column funnels first: for example
        @(Tab.Overrides ? "Client CEDAR, Side Buy and Qty at least 10, for CEDAR buying 10 or more;" : "Client CEDAR and Instrument starting BTC, for every CEDAR fill in BTC;")
        then add it here.
    </p>
    <div class="alerts-new">
        <span class="muted">New alert on @Tab.Title, @Describe(Filter):</span>
        <input type="text" placeholder="@NamePlaceholder()" @bind="_name" aria-label="Name" />
        <select @bind="_when" aria-label="When it fires">
            @WhenOptions
        </select>
        <select @bind="_sound" aria-label="Sound">
            @foreach (var (id, label) in AlertSounds.All)
            {
                <option value="@id">@label</option>
            }
        </select>
        <button type="button" class="icon-button" title="Hear it" aria-label="Hear the sound chosen" onclick="blotterAlerts.play(this.previousElementSibling.value)">▶</button>
        <select @bind="_throttle" aria-label="At most once every">
            @foreach (var throttle in AlertRule.Throttles)
            {
                <option value="@throttle.TotalSeconds">at most every @Seconds(throttle)</option>
            }
        </select>
        <button type="button" @onclick="AddAsync">Add</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public AlertBook Book { get; set; } = default!;

    [Parameter, EditorRequired]
    public Tab Tab { get; set; } = default!;

    /// <summary>The tab's filters now, which a new alert takes.</summary>
    [Parameter, EditorRequired]
    public FilterSpec Filter { get; set; } = default!;

    private string _name = "";
    private string _sound = AlertSounds.Default;
    private double _throttle = 3;
    private string _when = "";

    // As a row arrives, or after it has waited this long for the database.
    private static readonly RenderFragment WhenOptions = __builder =>
    {
        <option value="">as it arrives</option>
        @foreach (var lag in AlertRule.Lags)
        {
            <option value="@When(lag)" title="Once it has waited over @Seconds(lag) for the database to hold it">over @Seconds(lag) behind</option>
        }
    };

    private static string When(TimeSpan? lag) => lag is { } l ? l.TotalSeconds.ToString(CultureInfo.InvariantCulture) : "";

    private static TimeSpan? Lag(string when) =>
        when.Length == 0 ? null : TimeSpan.FromSeconds(double.Parse(when, CultureInfo.InvariantCulture));

    // With no filters set, the name box shows an example of a name, as the line above shows one of a condition.
    private string NamePlaceholder() => Filter.Columns.IsEmpty
        ? (Tab.Overrides ? "e.g. CEDAR buys of 10 or more" : "e.g. CEDAR fills in BTC")
        : Describe(Filter);

    private string DefaultName() => (Filter.Columns.IsEmpty ? (Tab.Overrides ? "Any order" : "Any fill") : Describe(Filter))
        + (Lag(_when) is { } lag ? $", over {Seconds(lag)} behind" : "");

    private async Task AddAsync()
    {
        var rule = new AlertRule(
            Guid.NewGuid().ToString("N"), string.IsNullOrWhiteSpace(_name) ? DefaultName() : _name.Trim(), Tab, Filter, _sound,
            TimeSpan.FromSeconds(_throttle), Muted: false, Lag(_when));
        _name = "";
        await Book.SaveAsync([.. Book.Rules, rule]);
    }

    private Task SaveAsync(AlertRule changed) => Book.SaveAsync([.. Book.Rules.Select(r => r.Id == changed.Id ? changed : r)]);

    private Task RemoveAsync(AlertRule removed) => Book.SaveAsync([.. Book.Rules.Where(r => r.Id != removed.Id)]);

    private static string Describe(FilterSpec filter) =>
        filter.Columns.IsEmpty ? "every row" : string.Join("; ", filter.Columns.Select(f => f.Describe()));

    private static string Seconds(TimeSpan throttle) =>
        throttle.TotalSeconds < 60 ? $"{throttle.TotalSeconds:0} s" : $"{throttle.TotalMinutes:0} min";
}
