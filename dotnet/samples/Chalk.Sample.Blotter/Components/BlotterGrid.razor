@* One tab's grid: sorted, filtered by any column, live, and for orders, with their fills nested. *@
@implements IAsyncDisposable
@inject BlotterHost Host
@inject IJSRuntime JS
@inject ILogger<BlotterGrid> Log
@inject NavigationManager Nav
@inject LinkShroud Shroud

<div class="tabs" role="tablist">
    @foreach (var tab in Tab.All)
    {
        var t = tab;
        <button role="tab" aria-selected="@(t == Tab)" class="tab @(t == Tab ? "selected" : "")" @onclick="() => Select.InvokeAsync(t)">@t.Title</button>
    }
    <span class="spacer"></span>
    @* Both copy in the browser itself, in the click: a clipboard takes nothing written later. *@
    <button type="button" class="icon-button" title="Copy the rows in view, to paste into a sheet or a message" aria-label="Copy the rows in view" onclick="blotter.copyRows(this)">
        <svg viewBox="0 0 16 16" width="11" height="11" aria-hidden="true"><rect x="5.5" y="5.5" width="8.5" height="8.5" rx="1.5" /><path d="M10.5 3.5V3a1.5 1.5 0 0 0-1.5-1.5H3A1.5 1.5 0 0 0 1.5 3v6A1.5 1.5 0 0 0 3 10.5h.5" /></svg>
    </button>
    @* The menu opens and closes in the browser alone, so a choice in it is still the click a clipboard asks for. *@
    <span class="share-wrap">
        <button type="button" class="icon-button" title="Copy a link to this view: its sort, filters and columns, and the row at the top unless it follows the live top" aria-label="Copy a link to this view" aria-haspopup="menu" onclick="blotter.toggleShare(this)">
            <svg viewBox="0 0 16 16" width="11" height="11" aria-hidden="true"><path d="M6.5 9.5l3-3" /><path d="M7.2 4.3l1.1-1.1a2.9 2.9 0 0 1 4.1 4.1l-1.1 1.1" /><path d="M8.8 11.7l-1.1 1.1a2.9 2.9 0 0 1-4.1-4.1l1.1-1.1" /></svg>
        </button>
        <span class="share-menu" role="menu">
            <button type="button" role="menuitem" title="The filters' values and the row at the top shrouded: the link shows only the tab, the sort and the columns" onclick="blotter.shareView(this, true)">Copy private link</button>
            <button type="button" role="menuitem" title="Everything in plain text, the filters' values and the row at the top included" onclick="blotter.shareView(this, false)">Copy readable link</button>
        </span>
    </span>
    <span class="chooser-wrap">
        <button type="button" class="link-button" aria-expanded="@_choosing" @onclick="() => _choosing = !_choosing">Columns <Chevron Down="true" Open="_choosing" /></button>
        @if (_choosing)
        {
            <div class="column-chooser" role="group" aria-label="Columns shown">
                @for (var c = Tab.Frozen; c < Tab.Columns.Count; c++)
                {
                    var column = Tab.Columns[c];
                    <label>
                        <input type="checkbox" checked="@(!_hiddenColumns.Contains(column.Name))"
                               @onchange="e => ShowColumnAsync(column, e.Value is true)" />
                        @column.Title
                    </label>
                }
            </div>
        }
    </span>
</div>

@if (!_filter.Columns.IsEmpty)
{
<div class="toolbar">
    @foreach (var filter in _filter.Columns)
    {
        var f = filter;
        <span class="pill filter-pill" @onclick="() => OpenEditor(f.Column)">
            @f.Describe()
            <button type="button" aria-label="Remove the filter on @f.Column.Title" @onclick="() => RemoveFilterAsync(f.Column)" @onclick:stopPropagation>×</button>
        </span>
    }
    <button type="button" class="link-button" @onclick="ClearFiltersAsync">Clear all</button>
</div>
}

@if (_editing is { } editing)
{
    <FilterEditor Tab="Tab" Column="editing" Current="_filter.For(editing)" Within="PeriodOfInterest()"
                  Apply="ApplyFilterAsync" Close="() => _editing = null" />
}

@if (_refusal is not null)
{
    <div class="refusal">
        Not serving: @_refusal
        <button @onclick="RetryAsync">Try again</button>
    </div>
}

@if (_failure is not null)
{
    <div class="refusal">
        This page could not be read: @_failure
        <button @onclick="ReloadAsync">Try again</button>
    </div>
}

<div class="frame">
    @if (NewAbove() is var above and > 0)
    {
        <button class="badge" @onclick="ShowNewestAsync">@above.ToString("N0", CultureInfo.InvariantCulture) new above</button>
    }

    <div class="scroller @(_waiting || _refusal is not null || _failure is not null ? "waiting" : "")" @ref="_scroller">
        <QuickGrid TGridItem="BlotterRow" @ref="_grid" Class="@(Tab.Overrides ? "nested" : null)" ItemsProvider="_provider" Virtualize="true" ItemSize="(float)RowHeight"
                   OverscanCount="60" ItemKey="r => r.Key" RowClass="@(r => r.Parent is null ? r.RowClass : "child " + r.RowClass)">
            @if (Tab.Overrides)
            {
                // The expander has a column of its own, so that opening an order moves nothing in its
                // row; its fills follow below it, each marked ↳.
                <TemplateColumn TGridItem="BlotterRow" Title="" Class="expander frozen">
                    @if (context.Parent is null && context.Row is Order order)
                    {
                        <button type="button" class="toggle" aria-label="@(_open.ContainsKey(order.OrderId) ? "Hide" : "Show") the fills of order @order.OrderId"
                                @onclick="() => ToggleAsync(order)">
                            <Chevron Open="_open.ContainsKey(order.OrderId)" />
                        </button>
                    }
                </TemplateColumn>
            }
            @for (var c = 0; c < Tab.Columns.Count; c++)
            {
                var index = c;
                var column = Tab.Columns[c];
                if (_hiddenColumns.Contains(column.Name))
                {
                    continue;
                }

                <TemplateColumn TGridItem="BlotterRow" Title="@column.Title" Class="@ColumnClass(column, index)">
                    <HeaderTemplate>
                        @if (column.Derived)
                        {
                            @* Only shown: worked out in the host from the row, so neither sorted nor filtered by. *@
                            <div class="head shown @(column.Numeric ? "num" : "")" title="@column.Description; worked out from the row, so not sorted or filtered by">
                                <span class="sort">@column.Title</span>
                            </div>
                        }
                        else
                        {
                        @* The whole heading sorts, its label button too (a click on it reaches the heading); the funnel does not.
                           The funnel sits just before the label, in the gutter every column keeps at its left. *@
                        <div class="head @(column.Numeric ? "num" : "")" @onclick="e => SortAsync(column, e.ShiftKey)"
                             title="@(column.Description is { } about ? about + ". " : "")Click to sort by @column.Title, descending, then ascending, then not; shift-click to do the same within a sort by several columns">
                            <span class="label">
                            <button type="button" class="funnel @(_filter.For(column) is not null ? "on" : "") @(_editing == column ? "open" : "")"
                                    title="Filter @column.Title" aria-label="Filter @column.Title" @onclick="() => OpenEditor(column)" @onclick:stopPropagation>
                                <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M1.5 2h13l-5 6.2V14l-3-1.6V8.2z" /></svg>
                            </button>
                            <button class="sort" type="button">
                                @column.Title
                                @* The arrow keeps its place when the column is not sorted, so the heading is as wide either way. *@
                                <span class="arrow @(_sort.RankOf(column) > 0 ? "" : _sort.ByDefault(column) ? "default" : "unsorted")">@(_sort.IsDescending(column) || _sort.RankOf(column) == 0 ? "▼" : "▲")</span>
                                @if (_sort.RankOf(column) is var rank and > 0 && _sort.Chosen.Length > 1)
                                {
                                    <span class="rank">@rank</span>
                                }
                            </button>
                            </span>
                        </div>
                        }
                    </HeaderTemplate>
                    <ChildContent>
                        @if (context.Row is Fill fill && context.Parent is not null)
                        {
                            @if (column.Kind == ColumnKind.Time)
                            {
                                @TimeCell(NestedCell(column, fill), NestedCell(column, fill, full: true), "")
                            }
                            else
                            {
                                <span class="cell @(column.Kind == ColumnKind.Id ? "id" : "")">@NestedCell(column, fill)</span>
                            }
                        }
                        else if (column.Name == "version")
                        {
                            <span class="cell @context.Flash[index]">v@(context.Row.Version)</span>
                        }
                        else if (column == Tab.Key && context.Row is Order own)
                        {
                            <span class="cell id @context.Flash[index]" title="@own.OrderId">
                                <a class="go" href="order/@own.OrderId" target="_blank" title="@own.OrderId: every version of this order, and its fills">@own.OrderId <span class="arrow">↗</span></a>
                            </span>
                        }
                        else if (column == Tab.Key && context.Row is Fill thisFill)
                        {
                            <span class="cell id @context.Flash[index]" title="@thisFill.FillId">
                                <a class="go" href="order/@thisFill.OrderId?fill=@thisFill.FillId" target="_blank" title="@thisFill.FillId: its order, every version and every fill, this one marked">@thisFill.FillId <span class="arrow">↗</span></a>
                            </span>
                        }
                        else if (column.Name == "order_id" && context.Row is Fill parentOf)
                        {
                            <span class="cell link id" @onmouseenter="e => HoverAsync(e, parentOf)" @onmouseleave="Unhover">
                                <a href="order/@parentOf.OrderId" target="_blank">@column.Show(context.Row)</a>
                            </span>
                        }
                        else if (column.Name == "side")
                        {
                            <span class="cell side-@column.Show(context.Row) @context.Flash[index]">@column.Show(context.Row)</span>
                        }
                        else
                        {
                            if (column.Kind == ColumnKind.Time)
                            {
                                @TimeCell(column.Show(context.Row), column.Detail(context.Row), context.Flash[index])
                            }
                            else
                            {
                                <span class="cell @(column.Kind == ColumnKind.Id ? "id" : "") @context.Flash[index]" title="@(column.Kind == ColumnKind.Id ? column.Show(context.Row) : null)">@column.Show(context.Row)</span>
                            }
                        }
                    </ChildContent>
                </TemplateColumn>
            }
        </QuickGrid>
    </div>

    @if (_hover is { } hover)
    {
        <div class="hover-card" style="left: @(hover.X)px; top: @(hover.Y)px">
            @if (hover.Looked && hover.Order is null)
            {
                <div><b>Order @hover.Fill.OrderId</b> · @hover.Fill.ClOrdId</div>
                <div class="muted">Not received yet: the fills stream runs ahead of the orders stream.</div>
            }
            else if (hover.Order is { } o)
            {
                <div><b>Order @o.OrderId</b> · @o.ClOrdId · v@(o.Version)</div>
                <div>@o.Client (@o.Region) via @o.Channel</div>
                <div><span class="side-@o.Side">@o.Side</span> @Column.Finance(o.Qty, 4) @o.Instrument</div>
                <div>filled @Column.Finance(o.FilledQty, 4) at @Column.Significant(o.AvgPrice) · @o.Status</div>
                @if (o.EventTime < hover.Fill.EventTime)
                {
                    <div class="muted">Its version with this fill has not arrived yet.</div>
                }
            }
            else
            {
                <div class="muted">Order @hover.Fill.OrderId…</div>
            }
        </div>
    }
</div>

@* Under the grid, one row: what opens beneath it, side by side while closed, then what the page acts with. *@
<div class="bar controls">
    @Toggles
    <button type="button" class="link-button disclosure" aria-expanded="@_explaining" @onclick="() => _explaining = !_explaining">
        <Chevron Open="_explaining" /> How this tab is answered
    </button>
    <span class="spacer"></span>
    <span class="actions">@Actions</span>
</div>

@Below

@if (_explaining)
{
<div class="explain">
    <p>
        Each page is read live from PostgreSQL (@(Tab.Overrides ? "orders_current, one row per order" : "fills")) through ChalkQL,
        from the key of a row already shown, with the sort, the filter and the limit pushed down; and merged with this
        filter's live scope, a ChalkQL standing view over the tail: what the streams have sent that the database has not
        been seen to hold yet.
    </p>
    <pre>@SourceQueries.ReadSql(Tab, _filter, _sort, fromKey: true)</pre>
    <pre>@LiveScope.Sql(Tab, _filter)</pre>
    <button @onclick="ShowPlansAsync">Show the plans</button>
    @if (_plans is not null)
    {
        <pre>@_plans</pre>
    }
</div>
}

@code {
    [Parameter, EditorRequired]
    public Tab Tab { get; set; } = default!;

    /// <summary>Toggles of the page's own, on the row under the table before this one's.</summary>
    [Parameter]
    public RenderFragment? Toggles { get; set; }

    /// <summary>What the page acts with, at the right of the row under the table.</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>What the page shows under that row, above how the tab is answered.</summary>
    [Parameter]
    public RenderFragment? Below { get; set; }

    /// <summary>Another tab chosen on this one's tab bar.</summary>
    [Parameter]
    public EventCallback<Tab> Select { get; set; }

    /// <summary>The view a link opened this tab on, if one did: its sort, filters, columns, and the row it was held at.</summary>
    [Parameter]
    public ViewLink? Link { get; set; }

    private const double RowHeight = 30;
    private Flashes _flashes = default!;

    // Columns the reader has hidden, by name; the frozen ones, which tell the rows apart, are always shown.
    private HashSet<string> _hiddenColumns = [];
    private bool _choosing;
    private bool _explaining;
    private Flashes _fillFlashes = new(Tab.Fills.Columns);
    private QuickGrid<BlotterRow>? _grid;
    private ElementReference _scroller;
    private DotNetObjectReference<BlotterGrid>? _self;
    private GridItemsProvider<BlotterRow> _provider = default!;
    private PageView _pages = default!;
    private LiveScope? _scope;
    private FilterSpec _filter = FilterSpec.None;
    private SortSpec _sort = default!;
    private string? _refusal;

    // Why the last page of this sort and filter could not be read. Unlike a refusal, it is not
    // retried as the feed moves on: a new sort or filter, or "Try again", reads afresh.
    private string? _failure;
    private string? _plans;
    private Column? _editing;

    // The grid is waiting for the first page of a new sort or filter: it stays as it was, dimmed.
    private bool _waiting;
    private long _reloads;

    // Scrolled away from the top, the grid holds its rows in place: rows arriving above it are counted
    // here rather than pushing the rows down, until the reader goes back to the top.
    private (IRow Key, long Position)? _anchor;
    private long _hidden;

    // Counts, from the streams, what arrives above the held rows; none while the grid follows the top.
    private ArrivalsAbove? _arrivals;

    // How far the rows really end from where the database's estimate or count puts the end: learned
    // from reads that reach the end. A count that replaces the estimate starts it again.
    private long _endLearned;
    private bool _counted;
    private const int GrowBy = 60;

    // Scrolling up near the top of what the reader has seen lets the rows that arrived above in, a few
    // at a time, holding the rows in view in place: _revealed counts those let in, which the reader may
    // not have scrolled up to yet.
    private const int RevealNear = 200;
    private const int RevealAtOnce = 30;
    private long _revealed;
    private long _shifted;
    private bool _revealing;
    private double _scrollTop;

    // The orders opened to show their fills, by id, each with the version last seen; and where a
    // read last found each, which is where its fills are let in.
    private readonly Dictionary<Guid, Order> _open = [];
    private readonly Dictionary<Guid, long> _openAt = [];
    private IReadOnlyList<Opened> _opened = [];

    private (Fill Fill, double X, double Y, bool Looked, Order? Order)? _hover;
    private int _refreshing;
    private bool _dirty;

    protected override async Task OnInitializedAsync()
    {
        _flashes = new Flashes(Tab.Columns);
        _hiddenColumns = [.. Link?.Hidden ?? Tab.HiddenAtFirst];
        _sort = Link?.Sort ?? Tab.DefaultSort;
        _filter = Link?.Filter ?? FilterSpec.None;
        _pages = Host.Pages.View(_sort);
        _provider = ProvideAsync;
        Host.Published += OnPublished;
        await AcquireAsync(_filter);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("blotter.watchScroll", _scroller, _self);
            if (Link?.At is { } at)
            {
                await HoldAtAsync(at);
            }
        }
    }

    /// <summary>
    /// Opens the grid where a link was made: the row it was held at counted to its place, the grid
    /// scrolled there and held, as if the reader had scrolled there; what arrives above is counted.
    /// </summary>
    private async Task HoldAtAsync(IRow at)
    {
        for (var wait = 0; wait < 200 && _scope?.State is not { Ready: true }; wait++)
        {
            await Task.Delay(50);
        }

        if (_scope?.State is not { Ready: true } state)
        {
            // Refused, or not ready: the reason is shown, and the grid stays at the top.
            return;
        }

        long rank;
        try
        {
            // Placing the row, an estimate will do if the count is too slow.
            rank = await Host.Pages.RankAsync(state, _sort, at, CancellationToken.None, orEstimate: true);
        }
        catch (QueryTimeLimitException limit)
        {
            Fail(_reloads, $"the link's row could not be placed, so the grid is at the top: {limit.Message}");
            return;
        }

        _pages.HoldAt(rank, at);
        _anchor = (at, rank);
        _arrivals?.Dispose();
        _arrivals = new ArrivalsAbove(Host, _sort, () => _scope?.State ?? state);
        _scrollTop = rank * RowHeight;

        // The grid learns how many rows it has first: until then it is not tall enough to scroll there.
        await RefreshAsync();
        await JS.InvokeVoidAsync("blotter.scrollTo", _scroller, rank * RowHeight);
    }

    /// <summary>
    /// A link to this view, for the share button: the sort, the filters, the columns hidden, and,
    /// scrolled away from the live top, the first row wholly in view, by its keyset; the filters'
    /// values and the row shrouded, if the link is to be private.
    /// </summary>
    [JSInvokable]
    public async Task<string> ShareLink(double scrollTop, bool shrouded)
    {
        IRow? at = null;
        if (_pages.Held && scrollTop >= RowHeight / 2 && _scope?.State is { Ready: true } state)
        {
            var slot = Nesting.Locate((long)Math.Ceiling(scrollTop / RowHeight), _opened);
            var page = await _pages.GetAsync(state, slot.Position, 1, CancellationToken.None);
            at = page.Rows.FirstOrDefault() ?? throw new InvalidOperationException("the row in view could not be read");
        }

        // Private, the filters' values and the row held at, which are data, are shrouded.
        var query = new ViewLink(Tab, _sort, _filter, _hiddenColumns, at).Query(shrouded ? Shroud : null);
        return Nav.BaseUri + (query.Length > 0 ? "?" + query : "");
    }

    [JSInvokable]
    public async Task OnScrolled(double scrollTop)
    {
        var atTop = scrollTop < RowHeight / 2;
        var wasAtTop = _scrollTop < RowHeight / 2;
        var up = scrollTop < _scrollTop;
        _scrollTop = scrollTop;
        if (wasAtTop && !atTop && !_pages.Held && _scope?.State is { Ready: true } state)
        {
            // Leaving the top: positions hold from here on, and the row now first in view is the one
            // whose rank says how many rows have arrived above it; a fill in view holds its order.
            _pages.Held = true;
            _arrivals?.Dispose();
            _arrivals = new ArrivalsAbove(Host, _sort, () => _scope?.State ?? state);
            var slot = Nesting.Locate((long)(scrollTop / RowHeight), _opened);
            try
            {
                var page = await _pages.GetAsync(state, slot.Position, 1, CancellationToken.None);
                if (page.Rows.Length == 1)
                {
                    _anchor = (page.Rows[0], page.Start);
                }
            }
            catch (Exception failure)
            {
                // Without the row in view, nothing counts what arrives above it; the rows still hold.
                Log.LogWarning(failure, "the row in view could not be read to hold the grid's place");
            }
        }
        else if (atTop && _pages.Held)
        {
            // Back at the top, however fast: what arrived above is shown, and new rows push down again.
            _pages.Held = false;
            _anchor = null;
            _arrivals?.Dispose();
        _arrivals = null;
            _hidden = 0;
            _revealed = 0;
            await RefreshAsync();
        }
        else if (up && _pages.Held && _hidden > 0 && !_revealing && scrollTop / RowHeight < RevealNear)
        {
            await RevealAsync();
        }
        else if (_revealed > 0)
        {
            StateHasChanged();
        }
    }

    /// <summary>
    /// Lets in up to <see cref="RevealAtOnce"/> of the rows that arrived above: every position the grid
    /// holds moves down by as many, and the scroll with them, so the rows in view stay where they are
    /// and the new ones are there to scroll up to. No more than the grid renders beyond the view, so the
    /// rows in view are on the page already when the scroll moves; and none again until the page says
    /// it has moved the scroll (<see cref="OnRevealed"/>), so two lots never stack.
    /// </summary>
    private async Task RevealAsync()
    {
        _revealing = true;
        try
        {
            var rows = Math.Min(_hidden, RevealAtOnce);
            _pages.Shift(rows);
            if (_anchor is { } anchor)
            {
                _anchor = (anchor.Key, anchor.Position + rows);
            }

            foreach (var id in _openAt.Keys.ToList())
            {
                _openAt[id] += rows;
            }

            _hidden -= rows;
            _revealed += rows;
            _shifted += rows;
            await JS.InvokeVoidAsync("blotter.insertAbove", _scroller, _self);
            await RefreshAsync();
        }
        catch
        {
            _revealing = false;
            throw;
        }
    }

    /// <summary>The page has put the rows in view back where they were: more may be let in.</summary>
    [JSInvokable]
    public void OnRevealed() => _revealing = false;

    /// <summary>What arrived above the rows in view: not let in yet, or let in and not yet scrolled up to.</summary>
    private long NewAbove() => _hidden + Math.Min(_revealed, (long)(_scrollTop / RowHeight));

    private async ValueTask<GridItemsProviderResult<BlotterRow>> ProvideAsync(GridItemsProviderRequest<BlotterRow> request)
    {
        var reloads = _reloads;
        var shifted = _shifted;
        var scope = _scope;
        if (scope is null && _refusal is not null)
        {
            // Refused: the rows shown stay, faded under the reason, until the host serves again.
            throw Keep(request.CancellationToken);
        }

        if (scope is null || !scope.State.Ready)
        {
            return GridItemsProviderResult.From<BlotterRow>([], 0);
        }

        if (scope.Fault is { } fault)
        {
            await InvokeAsync(() => Refuse($"the live scope failed: {fault.Message}"));
            throw Keep(request.CancellationToken);
        }

        var state = scope.State;
        var ct = request.CancellationToken;
        try
        {
            // What has arrived above the held rows, from the streams: the rows that crossed the topmost
            // row the view knows since the last state, up or down.
            if (_arrivals is not null && _pages.First is { } top)
            {
                _hidden = Math.Max(0, _hidden + await _arrivals.TakeAsync(top.Row, ct));
            }

            var hidden = _hidden;
            var counted = Host.Pages.IsCounted(state);
            if (counted != _counted)
            {
                // A count has replaced the estimate: what was learned against the estimate no longer holds.
                _counted = counted;
                _endLearned = 0;
            }

            // Following the live top, the estimate sizes the scroll bar well enough: rows are counted only
            // once the reader scrolls away.
            var estimated = Math.Max(0, await Host.Pages.TotalAsync(state, ct, count: _pages.Held) - hidden);
            var rows = Math.Max(0, estimated + _endLearned);

            // The opened orders are let in where a read last found them. A read that finds one
            // somewhere else, or finds another row where it was, moves it, and the grid's rows are
            // worked out again.
            IReadOnlyList<Opened> opened = [];
            List<Slot> slots = [];
            Page? page = null;
            var asked = 0;
            for (var pass = 0; pass < 3; pass++)
            {
                opened = await OpenedAsync(state, rows, ct);
                slots = Nesting.Map(request.StartIndex, request.Count ?? 60, rows, opened);
                var positions = slots.Where(s => !s.IsFill).Select(s => s.Position).ToList();

                // At the end the grid has found, a row more is asked for: if there is one, the rows go on.
                asked = positions.Count == 0 ? 0 : (int)(positions[^1] - positions[0] + 1);
                var atEnd = positions.Count > 0 && positions[^1] >= rows - 1;
                page = positions.Count == 0
                    ? null
                    : await _pages.GetAsync(state, positions[0], asked + (atEnd ? 1 : 0), ct);
                if (!Learn(page, shifted))
                {
                    break;
                }
            }

            // Where the rows end, learned from the read: one short of what it asked for found the last
            // row; one that found more at the end the grid had goes on a screenful further.
            if (page is not null && asked > 0)
            {
                var reached = page.Start + page.Rows.Length;
                if (page.Rows.Length < asked)
                {
                    _endLearned = reached - estimated;
                    rows = reached;
                }
                else if (page.Rows.Length > asked)
                {
                    _endLearned += GrowBy;
                    rows += GrowBy;
                }
            }

            if (shifted != _shifted)
            {
                // Rows were let in above while this was read: its rows are placed by positions the
                // grid no longer has, and the read that letting them in asked for is on its way.
                throw new OperationCanceledException(ct);
            }

            var now = DateTime.UtcNow;
            var shown = new List<BlotterRow>(slots.Count);
            foreach (var slot in slots)
            {
                if (slot.Under is { } under)
                {
                    shown.Add(_fillFlashes.Decorate(under.Fills[slot.Fill], now, under.Order.OrderId));
                }
                else if (page is not null && slot.Position - page.Start is var at && at >= 0 && at < page.Rows.Length)
                {
                    shown.Add(_flashes.Decorate(page.Rows[at], now));
                }
            }

            _flashes.Seen(state.IngestedThrough, now);
            _fillFlashes.Seen(state.IngestedThrough, now);
            _opened = opened;
            if (_waiting && reloads == _reloads || _hiddenShown != hidden)
            {
                _hiddenShown = hidden;
                _waiting = _waiting && reloads != _reloads;
                await InvokeAsync(StateHasChanged);
            }

            if (!_frozen && shown.Count > 0)
            {
                _ = InvokeAsync(FreezeColumnsAsync);
            }

            return GridItemsProviderResult.From(shown, (int)Math.Min(int.MaxValue, Nesting.Total(rows, opened)));
        }
        catch (OperationCanceledException cancelled) when (ct.IsCancellationRequested || cancelled.CancellationToken == ct)
        {
            // A newer sort, filter or scroll took over: the grid lets a request go quietly only
            // when it is cancelled with the request's own token.
            throw new OperationCanceledException(ct);
        }
        catch (QueryTimeLimitException limit)
        {
            await InvokeAsync(() => Fail(reloads, limit.Message));
            throw Keep(ct);
        }
        catch (BlotterRefusedException refused)
        {
            await InvokeAsync(() => Refuse(refused.Message));
            throw Keep(ct);
        }
        catch (Exception failure)
        {
            Log.LogError(failure, "a page of {Tab} sorted by {Sort}, filtered by {Filter}, could not be read", Tab.Name, _sort, _filter);
            await InvokeAsync(() => Fail(reloads, failure.Message));
            throw Keep(ct);
        }
    }

    /// <summary>
    /// A page that could not be read leaves the rows shown as they are, faded under the reason, rather
    /// than emptying the grid: the grid lets a request go, and keeps what it has, when it is cancelled
    /// with the request's own token.
    /// </summary>
    private static OperationCanceledException Keep(CancellationToken request) => new(request);

    private long _hiddenShown;

    // Columns keep the widths they first took with rows in them: the table does not size them again
    // for the rows each render brings, so headings do not shift as the grid scrolls.
    private bool _frozen;

    /// <summary>Shows or hides a column; the columns are measured and frozen again with the new set.</summary>
    private async Task ShowColumnAsync(Column column, bool shown)
    {
        if (shown ? !_hiddenColumns.Remove(column.Name) : !_hiddenColumns.Add(column.Name))
        {
            return;
        }

        _frozen = false;
        await JS.InvokeVoidAsync("blotter.unfreezeColumns", _scroller);
        await RefreshAsync();
    }

    private async Task FreezeColumnsAsync()
    {
        if (_frozen)
        {
            return;
        }

        // After the rows just provided are on the page.
        await Task.Delay(100);
        _frozen = await JS.InvokeAsync<bool>("blotter.freezeColumns", _scroller);
    }

    /// <summary>The opened orders whose place is known, in order of position, each with its fills now.</summary>
    private async Task<IReadOnlyList<Opened>> OpenedAsync(ScopeState state, long rows, CancellationToken ct)
    {
        var opened = new List<Opened>();
        foreach (var (id, position) in _openAt.ToList())
        {
            if (position < rows && _open.TryGetValue(id, out var order))
            {
                opened.Add(new Opened(position, order, await Host.Pages.FillsOfAsync(state, id, ct)));
            }
        }

        return [.. opened.OrderBy(o => o.Position)];
    }

    /// <summary>What a read says of the opened orders: where each it holds is, and which are no longer where they were.</summary>
    private bool Learn(Page? page, long shifted)
    {
        if (page is null || shifted != _shifted)
        {
            // Rows were let in above while it was read: its positions are no longer the grid's.
            return false;
        }

        var changed = false;
        for (var i = 0; i < page.Rows.Length; i++)
        {
            if (page.Rows[i] is Order order && _open.ContainsKey(order.OrderId))
            {
                _open[order.OrderId] = order;
                if (!_openAt.TryGetValue(order.OrderId, out var was) || was != page.Start + i)
                {
                    _openAt[order.OrderId] = page.Start + i;
                    changed = true;
                }
            }
        }

        foreach (var (id, position) in _openAt.ToList())
        {
            var at = position - page.Start;
            if (at >= 0 && at < page.Rows.Length && page.Rows[at].Id != id)
            {
                _openAt.Remove(id);
                changed = true;
            }
        }

        return changed;
    }

    /// <summary>A column's classes: right-aligned for numbers; frozen for the first few, which stay in place as the grid scrolls sideways.</summary>
    private string ColumnClass(Column column, int index) => string.Join(' ', new[]
    {
        column.Numeric ? "num" : null,
        index < Tab.Frozen ? "frozen" : null,
        index == Tab.Frozen - 1 ? "frozen-last" : null,
    }.Where(c => c is not null));

    /// <summary>
    /// A time with its date cut off at the left: the date, in a box an ellipsis wide, shown as one,
    /// then the time of day, whole, after a space; on hover, the time in full, date and microseconds.
    /// The date is still there, to copy.
    /// </summary>
    private static RenderFragment TimeCell(string shown, string full, string? flash) => __builder =>
    {
        var space = shown.IndexOf(' ');
        <span class="cell time @flash" title="@full"><span class="date">@shown[..space]</span>@shown[space..]</span>
    };

    private string NestedCell(Column column, Fill fill, bool full = false) => column.Name switch
    {
        "order_id" => $"↳ fill {fill.FillId}",
        "version" or "filled_qty" => "",
        "order_time" or "event_time" => full ? Tab.Fills.Named("event_time").Detail(fill) : Tab.Fills.Named("event_time").Show(fill),
        "avg_price" => Tab.Fills.Named("price").Show(fill),
        "status" => "fill",
        var name when Tab.Fills.Columns.Any(c => c.Name == name) => Tab.Fills.Named(name).Show(fill),
        _ => "",
    };

    private async Task ToggleAsync(Order order)
    {
        if (!_open.Remove(order.OrderId))
        {
            _open[order.OrderId] = order;
        }
        else
        {
            _openAt.Remove(order.OrderId);
        }

        await RefreshAsync();
    }

    /// <summary>
    /// The fill's order, as both sides know it now: its latest version, from the database or the tail.
    /// The order, or the version that counts the fill, may not have arrived yet, and the card says so.
    /// </summary>
    private async Task HoverAsync(MouseEventArgs mouse, Fill fill)
    {
        _hover = (fill, mouse.ClientX + 14, mouse.ClientY + 10, false, null);
        try
        {
            var history = await Host.Queries.HistoryAsync(fill.OrderId, CancellationToken.None);
            if (_hover is { } hover && hover.Fill == fill)
            {
                _hover = hover with { Looked = true, Order = history.Length > 0 ? history[0] : null };
            }
        }
        catch (Exception failure) when (failure is QueryTimeLimitException or InvalidOperationException)
        {
            _hover = null;
        }
    }

    private void Unhover() => _hover = null;

    private void OnPublished(long version)
    {
        if (Interlocked.Exchange(ref _refreshing, 1) == 1)
        {
            _dirty = true;
            return;
        }

        _ = InvokeAsync(async () =>
        {
            try
            {
                do
                {
                    _dirty = false;
                    if (_scope?.Fault is { } fault)
                    {
                        Refuse($"the live scope failed: {fault.Message}");
                    }
                    else if (Host.State != BlotterState.Live)
                    {
                        Refuse(Host.Refusal ?? "the blotter is not serving");
                    }
                    else if (_refusal is not null || _scope is null)
                    {
                        // Serving again: take a scope again and read the first page afresh.
                        await RetryAsync();
                    }
                    else if (_grid is not null && !_waiting && _failure is null)
                    {
                        await _grid.RefreshDataAsync();
                    }

                    // At most ten pages a second, however fast the feed is: changes in between are
                    // in the scope's next state, not lost.
                    await Task.Delay(100);
                }
                while (_dirty);
            }
            finally
            {
                Volatile.Write(ref _refreshing, 0);
            }
        });
    }

    private async Task SortAsync(Column column, bool shift)
    {
        var was = _sort;
        _sort = _sort.Click(column, shift);
        if (_sort.Name == was.Name)
        {
            // The same order, newest first, chosen or by default: only the headers change.
            return;
        }

        _pages = Host.Pages.View(_sort);
        await ReloadAsync();
    }

    private void OpenEditor(Column column) => _editing = _editing == column ? null : column;

    private async Task ApplyFilterAsync(ColumnFilter filter) => await FilterAsync(_filter.With(filter));

    private async Task RemoveFilterAsync(Column column) => await FilterAsync(_filter.Without(column));

    private async Task ClearFiltersAsync() => await FilterAsync(FilterSpec.None);

    private async Task FilterAsync(FilterSpec filter)
    {
        _editing = null;
        if (filter.Name == _filter.Name)
        {
            return;
        }

        _filter = filter;
        _waiting = true;
        await AcquireAsync(filter);
        await ReloadAsync();
    }

    /// <summary>The rows the chooser offers values from: the tab's time filter, or the last day.</summary>
    private (DateTime From, DateTime To) PeriodOfInterest()
    {
        var time = _filter.For(Tab.Time);
        var to = time?.To ?? Cells.Micros(DateTime.UtcNow.AddMinutes(1));
        return (time?.From ?? to.AddDays(-1), to);
    }

    /// <summary>A new sort or filter: the rows stay as they are, dimmed, until the first page of the new one is in.</summary>
    private async Task ReloadAsync()
    {
        _reloads++;
        _waiting = true;
        _failure = null;
        _pages.Reset();
        _pages.Held = false;
        _openAt.Clear();
        _anchor = null;
        _arrivals?.Dispose();
        _arrivals = null;
        _endLearned = 0;
        _hidden = 0;
        _revealed = 0;
        _plans = null;
        _flashes.Clear();
        _fillFlashes.Clear();
        await JS.InvokeVoidAsync("blotter.scrollToTop", _scroller);
        if (_grid is not null)
        {
            await _grid.RefreshDataAsync();
        }
    }

    private async Task AcquireAsync(FilterSpec filter)
    {
        var previous = _scope;
        try
        {
            _scope = await Host.AcquireAsync(Tab, filter, CancellationToken.None);
            _refusal = null;
        }
        catch (BlotterRefusedException refused)
        {
            _scope = null;
            Refuse(refused.Message);
        }

        if (previous is not null && previous != _scope)
        {
            await Host.ReleaseAsync(previous);
        }
    }

    private async Task RetryAsync()
    {
        _refusal = null;
        if (_scope is { Fault: not null } failed)
        {
            _scope = null;
            await Host.ReleaseAsync(failed);
        }

        await AcquireAsync(_filter);
        await ReloadAsync();
    }

    /// <summary>A page of the sort and filter chosen at <paramref name="reloads"/> failed: said, unless a newer one has been chosen since.</summary>
    private void Fail(long reloads, string why)
    {
        if (reloads != _reloads)
        {
            return;
        }

        _waiting = false;
        _failure = why;
        StateHasChanged();
    }

    private void Refuse(string why)
    {
        _waiting = false;
        if (_refusal != why)
        {
            _refusal = why;
            StateHasChanged();
        }
    }

    private async Task ShowNewestAsync()
    {
        _anchor = null;
        _arrivals?.Dispose();
        _arrivals = null;
        _hidden = 0;
        _revealed = 0;
        _pages.Held = false;
        await JS.InvokeVoidAsync("blotter.scrollToTop", _scroller);
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        if (_grid is not null)
        {
            await _grid.RefreshDataAsync();
        }

        StateHasChanged();
    }

    private async Task ShowPlansAsync()
    {
        var page = (await Host.Queries.EstimateAsync(_filter, _sort, CancellationToken.None)).PlanText;
        _plans = "-- a page of the database\n" + page + "\n-- the live scope\n" + (_scope?.PlanText ?? "");
    }

    public async ValueTask DisposeAsync()
    {
        Host.Published -= OnPublished;
        _arrivals?.Dispose();
        if (_scope is not null)
        {
            await Host.ReleaseAsync(_scope);
        }

        _self?.Dispose();
    }
}
