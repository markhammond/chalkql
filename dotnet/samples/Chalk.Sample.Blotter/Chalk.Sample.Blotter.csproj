<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Chalk.Sample.Blotter</RootNamespace>
    <AssemblyName>Chalk.Sample.Blotter</AssemblyName>
    <!-- Incremental maintenance of the live scopes is experimental (CHALK003): acknowledged here. -->
    <NoWarn>$(NoWarn);CHALK003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Chalk.Sample.Blotter.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Chalk.Client/Chalk.Client.csproj" />
    <ProjectReference Include="../../src/Chalk.Incremental/Chalk.Incremental.csproj" />
    <ProjectReference Include="../../src/Chalk.Sources.Poco/Chalk.Sources.Poco.csproj" />
    <ProjectReference Include="../../src/Chalk.Sources.Ado/Chalk.Sources.Ado.csproj" />
  </ItemGroup>

  <!-- The provider for the database: the ADO.NET source takes any, and this host picks Npgsql. -->
  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid" />
  </ItemGroup>

</Project>
