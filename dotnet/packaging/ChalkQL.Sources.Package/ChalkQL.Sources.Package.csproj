<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Optional stock source implementations. The source abstraction itself stays in ChalkQL:
    a host implementing ISourceRuntime should not need this package.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>ChalkQL.Sources</PackageId>
    <PackageTags>
      sql;federated-sql;query-engine;ado.net;duckdb;poco;apache-arrow
    </PackageTags>
    <PackageProjectUrl>https://github.com/markhammond/chalkql</PackageProjectUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>
      ChalkQL.Sources 0.3 adds composite columns for POCO and Akade sources,
      sovereign-zone catalogue validation, stricter source row-level-security trust,
      and source compatibility with ChalkQL's corrected numeric semantics.

      Source builders now support Zone(...), catalogues are restricted to one declared
      sovereign zone, TrustSourceRowLevelSecurity(...) requires explicit security
      preconditions, and composite columns remain local-only and non-indexable.

      Requires exactly ChalkQL 0.3.0.

      Full release notes:
      https://github.com/markhammond/chalkql/releases/tag/v0.3
    </PackageReleaseNotes>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <RepositoryUrl>https://github.com/markhammond/chalkql.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <Authors>Mark Hammond</Authors>
    <Description>
      Built-in ChalkQL sources for POCO and Akade.IndexedSet collections, ADO.NET and DuckDB + source conformance tooling.
    </Description>

    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>

    <!--
      Packaging projects deliberately opt out of Central Package Management. They synthesise the
      dependency manifest for several constituent assemblies.
    -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS2008</NoWarn>

    <RepoRoot Condition="'$(RepoRoot)' == ''">$(MSBuildThisFileDirectory)../../../</RepoRoot>
    <PackageTfm>net10.0</PackageTfm>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md"
          Pack="true"
          PackagePath="/" />
  </ItemGroup>
  
  <!--
    Exact-version coupling is intentional: ChalkQL and ChalkQL.Sources are one release train.
    pack.sh packs ChalkQL first and adds the output directory as an additional restore source
    before restoring/packing this project.
  -->
  <ItemGroup>
    <PackageReference Include="ChalkQL" Version="[$(PackageVersion)]" />
  </ItemGroup>

  <!-- Direct third-party dependencies of Ado/Akade/Conformance/DuckDb/Poco. -->
  <Import Project="../generated/ChalkQL.Sources.Dependencies.props"
          Condition="Exists('../generated/ChalkQL.Sources.Dependencies.props')" />
  
  <ItemGroup>
    <_ManagedAssembly Include="$(RepoRoot)dotnet/src/Chalk.Sources.Ado/bin/$(Configuration)/$(PackageTfm)/Chalk.Sources.Ado.dll" />
    <_ManagedAssembly Include="$(RepoRoot)dotnet/src/Chalk.Sources.Akade/bin/$(Configuration)/$(PackageTfm)/Chalk.Sources.Akade.dll" />
    <_ManagedAssembly Include="$(RepoRoot)dotnet/src/Chalk.Sources.Conformance/bin/$(Configuration)/$(PackageTfm)/Chalk.Sources.Conformance.dll" />
    <_ManagedAssembly Include="$(RepoRoot)dotnet/src/Chalk.Sources.DuckDb/bin/$(Configuration)/$(PackageTfm)/Chalk.Sources.DuckDb.dll" />
    <_ManagedAssembly Include="$(RepoRoot)dotnet/src/Chalk.Sources.Poco/bin/$(Configuration)/$(PackageTfm)/Chalk.Sources.Poco.dll" />

    <None Include="@(_ManagedAssembly)"
          Pack="true"
          PackagePath="lib/$(PackageTfm)/" />

    <None Include="$(RepoRoot)dotnet/src/Chalk.Sources.Ado/bin/$(Configuration)/$(PackageTfm)/Chalk.Sources.Ado.xml"
          Pack="true" PackagePath="lib/$(PackageTfm)/"
          Condition="Exists('$(RepoRoot)dotnet/src/Chalk.Sources.Ado/bin/$(Configuration)/$(PackageTfm)/Chalk.Sources.Ado.xml')" />
    <None Include="$(RepoRoot)dotnet/src/Chalk.Sources.Akade/bin/$(Configuration)/$(PackageTfm)/Chalk.Sources.Akade.xml"
          Pack="true" PackagePath="lib/$(PackageTfm)/"
          Condition="Exists('$(RepoRoot)dotnet/src/Chalk.Sources.Akade/bin/$(Configuration)/$(PackageTfm)/Chalk.Sources.Akade.xml')" />
    <None Include="$(RepoRoot)dotnet/src/Chalk.Sources.Conformance/bin/$(Configuration)/$(PackageTfm)/Chalk.Sources.Conformance.xml"
          Pack="true" PackagePath="lib/$(PackageTfm)/"
          Condition="Exists('$(RepoRoot)dotnet/src/Chalk.Sources.Conformance/bin/$(Configuration)/$(PackageTfm)/Chalk.Sources.Conformance.xml')" />
    <None Include="$(RepoRoot)dotnet/src/Chalk.Sources.DuckDb/bin/$(Configuration)/$(PackageTfm)/Chalk.Sources.DuckDb.xml"
          Pack="true" PackagePath="lib/$(PackageTfm)/"
          Condition="Exists('$(RepoRoot)dotnet/src/Chalk.Sources.DuckDb/bin/$(Configuration)/$(PackageTfm)/Chalk.Sources.DuckDb.xml')" />
    <None Include="$(RepoRoot)dotnet/src/Chalk.Sources.Poco/bin/$(Configuration)/$(PackageTfm)/Chalk.Sources.Poco.xml"
          Pack="true" PackagePath="lib/$(PackageTfm)/"
          Condition="Exists('$(RepoRoot)dotnet/src/Chalk.Sources.Poco/bin/$(Configuration)/$(PackageTfm)/Chalk.Sources.Poco.xml')" />
  </ItemGroup>

  <Target Name="ValidateChalkQLSourcesPackageInputs" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('../generated/ChalkQL.Sources.Dependencies.props')"
           Text="Missing generated/ChalkQL.Sources.Dependencies.props. Run scripts/nuget-package-dependencies.py (pack.sh does this)." />
    
    <Error Condition="!Exists('%(_ManagedAssembly.Identity)')"
           Text="Missing ChalkQL.Sources package input: %(_ManagedAssembly.Identity). Build dotnet/Chalk.slnx first." />
  </Target>
</Project>
