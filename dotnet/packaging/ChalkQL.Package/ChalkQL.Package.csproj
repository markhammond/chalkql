<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Public ChalkQL package.

    This is deliberately a packaging project only: ChalkQL keeps its internal assembly/project
    boundaries, while the public NuGet surface exposes one core package plus ChalkQL.Sources.

    scripts/pack.sh builds the real projects first, generates the direct third-party
    PackageReference union, then packs this project.

    The Calcite planner sidecar is embedded as a resource in Chalk.Client.dll. It is materialised
    lazily by PlannerProcess only when a local sidecar is started; it is therefore not carried as
    a separate NuGet content/tool asset.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>ChalkQL</PackageId>
    <PackageTags>
      sql;federated-sql;poco;query-engine;planner;optimizer;apache-calcite;calcite;arrow;
      access-control;authorization;entitlements;multi-tenant
    </PackageTags>
    <PackageProjectUrl>https://github.com/markhammond/chalkql</PackageProjectUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>
      ChalkQL 0.6 lets standing views and refreshes run side by side, rebinds a view's parameters without planning again, and maintains window functions incrementally.

      - **Views and refreshes:** An update a refresh overtakes is published at the version it read, never thrown away, and no refresh waits for a view. A refresh that writes nothing a view reads moves the view on without computing. Commits carry a stamp of version and generation, and `UpdateToAsync` waits for one. `RefreshBuilder.Barrier()` marks a refresh every view publishes itself, and `ViewVersions.Every` makes a view publish every version, in order.
      - **Rebindable parameters:** `ViewOptions.Rebindable` and `RebindAsync` move a view's parameters, lists included up to a declared capacity, keeping its plan. Maintained incrementally, only the operators that read a moved value run again.
      - **Maintained windows (experimental):** `ROW_NUMBER`, `RANK`, `LAG`, `LEAD`, running aggregates and the like are maintained from the rows a change reaches, rather than recomputed.
      - **Planner and execution fixes:** set operations over columns of different precisions plan; a parameter in a `CASE` branch and a window's constant parameter type; timestamps are cut to their declared precision; hash joins with many rows per key build in linear time.
      - **Compatibility:** No public API is removed or changed. A view now sends readers a commit at a version it relabels without an update, and timestamps cast to a precision lose the digits beyond it. The wire protocol and IR version are unchanged; a 0.5 planner serves a 0.6 client but lacks the planner's fixes.

      Full release notes:
      https://github.com/markhammond/chalkql/releases/tag/v0.6
    </PackageReleaseNotes>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <RepositoryUrl>https://github.com/markhammond/chalkql.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <Authors>Mark Hammond</Authors>
    <Description>
      Zero-trust federated SQL with vectorised execution for .NET. Query planning and optimisation powered by Apache Calcite.
    </Description>
    
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>

    <!--
      Packaging projects deliberately opt out of Central Package Management. They synthesise the
      dependency manifest for several constituent assemblies.
    -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS2008</NoWarn>

    <!-- May be overridden by the packing script. -->
    <RepoRoot Condition="'$(RepoRoot)' == ''">$(MSBuildThisFileDirectory)../../../</RepoRoot>
    <PackageTfm>net10.0</PackageTfm>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md"
          Pack="true"
          PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <None Include="LICENSE.txt" 
          Pack="true" 
          PackagePath="" />
  </ItemGroup>
  
  <!-- Generated from the direct PackageReferences of the constituent projects. -->
  <Import Project="../generated/ChalkQL.Dependencies.props"
          Condition="Exists('../generated/ChalkQL.Dependencies.props')" />

  <ItemGroup>
    <_ManagedAssembly Include="$(RepoRoot)dotnet/src/Chalk/bin/$(Configuration)/$(PackageTfm)/Chalk.dll" />
    <_ManagedAssembly Include="$(RepoRoot)dotnet/src/Chalk.Catalog/bin/$(Configuration)/$(PackageTfm)/Chalk.Catalog.dll" />
    <_ManagedAssembly Include="$(RepoRoot)dotnet/src/Chalk.Client/bin/$(Configuration)/$(PackageTfm)/Chalk.Client.dll" />
    <_ManagedAssembly Include="$(RepoRoot)dotnet/src/Chalk.Entitlements/bin/$(Configuration)/$(PackageTfm)/Chalk.Entitlements.dll" />
    <_ManagedAssembly Include="$(RepoRoot)dotnet/src/Chalk.Entitlements.Tenancy/bin/$(Configuration)/$(PackageTfm)/Chalk.Entitlements.Tenancy.dll" />
    <_ManagedAssembly Include="$(RepoRoot)dotnet/src/Chalk.Incremental/bin/$(Configuration)/$(PackageTfm)/Chalk.Incremental.dll" />
    <_ManagedAssembly Include="$(RepoRoot)dotnet/src/Chalk.Execution/bin/$(Configuration)/$(PackageTfm)/Chalk.Execution.dll" />
    <_ManagedAssembly Include="$(RepoRoot)dotnet/src/Chalk.Ir/bin/$(Configuration)/$(PackageTfm)/Chalk.Ir.dll" />
    <_ManagedAssembly Include="$(RepoRoot)dotnet/src/Chalk.Sources.Abstractions/bin/$(Configuration)/$(PackageTfm)/Chalk.Sources.Abstractions.dll" />

    <None Include="@(_ManagedAssembly)"
          Pack="true"
          PackagePath="lib/$(PackageTfm)/" />
  </ItemGroup>

  <!-- XML API documentation, when emitted by the constituent project. -->
  <ItemGroup>
    <None Include="$(RepoRoot)dotnet/src/Chalk/bin/$(Configuration)/$(PackageTfm)/Chalk.xml"
          Pack="true"
          PackagePath="lib/$(PackageTfm)/"
          Condition="Exists('$(RepoRoot)dotnet/src/Chalk/bin/$(Configuration)/$(PackageTfm)/Chalk.xml')" />

    <None Include="$(RepoRoot)dotnet/src/Chalk.Catalog/bin/$(Configuration)/$(PackageTfm)/Chalk.Catalog.xml"
          Pack="true"
          PackagePath="lib/$(PackageTfm)/"
          Condition="Exists('$(RepoRoot)dotnet/src/Chalk.Catalog/bin/$(Configuration)/$(PackageTfm)/Chalk.Catalog.xml')" />

    <None Include="$(RepoRoot)dotnet/src/Chalk.Client/bin/$(Configuration)/$(PackageTfm)/Chalk.Client.xml"
          Pack="true"
          PackagePath="lib/$(PackageTfm)/"
          Condition="Exists('$(RepoRoot)dotnet/src/Chalk.Client/bin/$(Configuration)/$(PackageTfm)/Chalk.Client.xml')" />

    <None Include="$(RepoRoot)dotnet/src/Chalk.Entitlements/bin/$(Configuration)/$(PackageTfm)/Chalk.Entitlements.xml"
          Pack="true"
          PackagePath="lib/$(PackageTfm)/"
          Condition="Exists('$(RepoRoot)dotnet/src/Chalk.Entitlements/bin/$(Configuration)/$(PackageTfm)/Chalk.Entitlements.xml')" />

    <None Include="$(RepoRoot)dotnet/src/Chalk.Entitlements.Tenancy/bin/$(Configuration)/$(PackageTfm)/Chalk.Entitlements.Tenancy.xml"
          Pack="true"
          PackagePath="lib/$(PackageTfm)/"
          Condition="Exists('$(RepoRoot)dotnet/src/Chalk.Entitlements.Tenancy/bin/$(Configuration)/$(PackageTfm)/Chalk.Entitlements.Tenancy.xml')" />

    <None Include="$(RepoRoot)dotnet/src/Chalk.Incremental/bin/$(Configuration)/$(PackageTfm)/Chalk.Incremental.xml"
          Pack="true"
          PackagePath="lib/$(PackageTfm)/"
          Condition="Exists('$(RepoRoot)dotnet/src/Chalk.Incremental/bin/$(Configuration)/$(PackageTfm)/Chalk.Incremental.xml')" />

    <None Include="$(RepoRoot)dotnet/src/Chalk.Execution/bin/$(Configuration)/$(PackageTfm)/Chalk.Execution.xml"
          Pack="true"
          PackagePath="lib/$(PackageTfm)/"
          Condition="Exists('$(RepoRoot)dotnet/src/Chalk.Execution/bin/$(Configuration)/$(PackageTfm)/Chalk.Execution.xml')" />

    <None Include="$(RepoRoot)dotnet/src/Chalk.Ir/bin/$(Configuration)/$(PackageTfm)/Chalk.Ir.xml"
          Pack="true"
          PackagePath="lib/$(PackageTfm)/"
          Condition="Exists('$(RepoRoot)dotnet/src/Chalk.Ir/bin/$(Configuration)/$(PackageTfm)/Chalk.Ir.xml')" />

    <None Include="$(RepoRoot)dotnet/src/Chalk.Sources.Abstractions/bin/$(Configuration)/$(PackageTfm)/Chalk.Sources.Abstractions.xml"
          Pack="true"
          PackagePath="lib/$(PackageTfm)/"
          Condition="Exists('$(RepoRoot)dotnet/src/Chalk.Sources.Abstractions/bin/$(Configuration)/$(PackageTfm)/Chalk.Sources.Abstractions.xml')" />
  </ItemGroup>

  <!--
    This describes the JVM dependencies shaded into the planner JAR embedded in Chalk.Client.dll.
    It remains package-level legal/documentation metadata even though the JAR itself is no longer
    a separately packaged file.
  -->
  <ItemGroup>
    <None Include="THIRD-PARTY-NOTICES.txt"
          Pack="true"
          PackagePath="/"
          Visible="false" />
  </ItemGroup>

  <Target Name="ValidateChalkQLPackageInputs"
          BeforeTargets="GenerateNuspec">

    <Error Condition="!Exists('../generated/ChalkQL.Dependencies.props')"
           Text="Missing generated/ChalkQL.Dependencies.props. Run scripts/nuget-package-dependencies.py (pack.sh does this)." />

    <!-- Referencing item metadata batches this Error once per assembly. -->
    <Error Condition="!Exists('%(_ManagedAssembly.Identity)')"
           Text="Missing ChalkQL package input: %(_ManagedAssembly.Identity). Build dotnet/Chalk.slnx first." />

    <Error Condition="!Exists('THIRD-PARTY-NOTICES.txt')"
           Text="Missing generated THIRD-PARTY-NOTICES.txt. Run scripts/third-party-notices.py." />
  </Target>
</Project>