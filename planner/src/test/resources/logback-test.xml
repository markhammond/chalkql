<configuration>
  <!-- Calcite logs every rule application at DEBUG; useful when a plan is wrong, deafening otherwise.
       Raise chalk / org.apache.calcite to DEBUG by hand when hunting a planning problem. -->
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>
  <root level="WARN">
    <appender-ref ref="STDERR" />
  </root>
</configuration>
